# Copie para .env e ajuste conforme o seu ambiente.
NODE_ENV=development

# Banco de dados (usado pela aplicação e pelo sequelize-cli)
# Em produção (Neon/Railway) basta a connection string única:
#   DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Localmente use as variáveis soltas abaixo.
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workflow_db
DB_NAME_TEST=workflow_db_test
DB_USER=postgres
DB_PASS=postgres
# SSL liga por padrão em produção; ponha false só para Postgres local sem TLS.
DB_SSL=false

# Servidor HTTP (o host de deploy injeta PORT automaticamente)
PORT=3333

# Segredos (troque em produção)
JWT_SECRET=dev-workflow-jwt-secret-change-me
COOKIE_SECRET=dev-workflow-cookie-secret-change-me

# Mercado Pago — Access Token (use o de teste/sandbox no dev; em produção troque a chave)
MP_ACCESS_TOKEN=
APP_BASE_URL=http://localhost:3333
FRONTEND_BASE_URL=http://localhost:3000
