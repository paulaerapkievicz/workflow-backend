# Copie para .env e ajuste conforme o seu ambiente.
NODE_ENV=development

# Banco de dados (usado pela aplicação e pelo sequelize-cli)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workflow_db
DB_NAME_TEST=workflow_db_test
DB_USER=postgres
DB_PASS=postgres

# Servidor HTTP
PORT=3333

# Segredos (troque em produção)
JWT_SECRET=dev-workflow-jwt-secret-change-me
COOKIE_SECRET=dev-workflow-cookie-secret-change-me
